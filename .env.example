# Server configuration (Use PORT=3080 and HOST=127.0.0.1 for local Ubuntu deployment)
PORT=3080
HOST=127.0.0.1
NODE_ENV=development

# OpenAI API configuration (Primary AI provider for Ubuntu standalone deployment)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Gemini API fallback (Automatically injected in AI Studio environment)
GEMINI_API_KEY=

# SQLite database path
DATABASE_PATH=./data/applications.db

# Optional bearer token required only if binding to a non-localhost interface
AUTH_TOKEN=
